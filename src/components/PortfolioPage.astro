---
import type { Locale } from '../data/portfolio';
import { portfolio } from '../data/portfolio';

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = portfolio[locale];
const languageHref = locale === 'en' ? '/pt/' : '/';
const alternateLocale = locale === 'en' ? 'pt' : 'en';
const [imobi, ...universalSystems] = copy.projectsList;
const secondaryProjects = universalSystems.slice(3);
const systemProjects = universalSystems.slice(0, 3);
const socials = {
  email: 'mailto:contactfrytinhas1910@gmail.com',
  linkedin: 'https://www.linkedin.com/in/jg-nunes',
  github: 'https://github.com/frytinhas',
};
---

<header class="site-header container">
  <a class="brand" href={locale === 'pt' ? '/pt/' : '/'} aria-label="José Nunes home">
    <img src="/jn-transparent-white.svg" alt="José Nunes" />
  </a>
  <nav aria-label={locale === 'pt' ? 'Navegação principal' : 'Primary navigation'}>
    <a href="#work">{copy.navigation.work}</a>
    <a href="#experience">{copy.navigation.experience}</a>
    <a href="#expertise">{copy.navigation.expertise}</a>
    <a href="#contact">{copy.navigation.contact}</a>
  </nav>
  <a class="language-switch" href={languageHref} data-language-switch={alternateLocale} aria-label={`${copy.languageLabel}: ${copy.switchLanguage}`}>{copy.switchLanguage}</a>
</header>

<main id="content">
  <section id="about" class="hero" aria-labelledby="hero-title">
    <div class="hero-diagram" aria-hidden="true">
      <span class="node node-a"></span><span class="node node-b"></span><span class="node node-c"></span><span class="node node-d"></span>
      <i class="line line-a"></i><i class="line line-b"></i><i class="line line-c"></i>
    </div>
    <div class="container hero-inner">
      <h1 id="hero-title">{copy.hero.headline}</h1>
      <p class="hero-intro">{copy.hero.intro}<span>{copy.hero.roleIntro}</span></p>
      <div class="hero-socials">
        <a href={socials.github} target="_blank" rel="noopener noreferrer" aria-label={copy.contact.github} style="background:#000; color:#fff; border-radius:9999px; display:inline-flex; align-items:center; justify-content:center; width:2.75rem; height:2.75rem;">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.09c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.68.08-.68 1.13.08 1.73 1.16 1.73 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.22.71-1.5-2.5-.28-5.13-1.25-5.13-5.56 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.15a10.8 10.8 0 0 1 5.64 0c2.15-1.46 3.1-1.15 3.1-1.15.61 1.55.23 2.7.11 2.98.72.79 1.16 1.79 1.16 3.02 0 4.32-2.63 5.27-5.14 5.55.4.35.76 1.04.76 2.1v3.07c0 .3.2.65.77.54A11.25 11.25 0 0 0 12 .75Z" /></svg>
        </a>
        <a href={socials.linkedin} target="_blank" rel="noopener noreferrer" aria-label={copy.contact.linkedin} style="background:#0a66c2; color:#fff; border-radius:9999px; display:inline-flex; align-items:center; justify-content:center; width:2.75rem; height:2.75rem;">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52c0-.84-.69-1.52-1.55-1.52ZM7.93 18.75H4.98V9.2h2.95v9.55ZM6.45 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.3 10.85H15.8V14.1c0-1.11-.02-2.54-1.55-2.54-1.55 0-1.79 1.21-1.79 2.46v4.73H9.51V9.2h2.83v1.31h.04c.39-.74 1.36-1.52 2.79-1.52 2.98 0 3.58 1.96 3.58 4.51v5.25Z" /></svg>
        </a>
        <a href={socials.email} aria-label={copy.contact.email} style="background:#fff; color:#111; border-radius:9999px; display:inline-flex; align-items:center; justify-content:center; width:2.75rem; height:2.75rem; border:1px solid rgba(17, 17, 17, 0.12);">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m3 6 9 7 9-7" /></svg>
        </a>
      </div>
      <div class="hero-actions">
        <a class="button button-primary" href="#work">{copy.hero.projects}<span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>

  <section id="work" class="section container" aria-labelledby="work-title">
    <div class="section-heading">
      <h2 id="work-title">{copy.projects.title}</h2>
      <p>{copy.projects.intro}</p>
    </div>
    <article class="project project-featured">
      <div class="project-visual imobi-visual">
        <img src={imobi.image} alt={imobi.imageAlt} loading="eager" decoding="async" />
        <span class="visual-grid" aria-hidden="true"></span>
      </div>
      <div class="project-copy">
        <p class="project-kind">{imobi.kind}</p>
        <h3>{imobi.name}</h3>
        <p>{imobi.description}</p>
        <ul class="tag-list">{imobi.tags.map((tag) => <li>{tag}</li>)}</ul>
        <a class="text-link" href={imobi.href} target="_blank" rel="noopener noreferrer">{copy.projects.visit}<span aria-hidden="true">↗</span></a>
      </div>
    </article>

    <div class="project-grid" aria-label={locale === 'pt' ? 'Universal Systems' : 'Universal Systems'}>
      {systemProjects.map((project) => <article class="project-card">
        <img src={project.image} alt={project.imageAlt} loading="lazy" decoding="async" />
        <div class="project-card-copy">
          <p class="project-kind">{project.kind}</p>
          <h3>{project.name}</h3>
          <p>{project.description}</p>
          <ul class="tag-list">{project.tags.map((tag) => <li>{tag}</li>)}</ul>
          <a class="text-link" href={project.href} target="_blank" rel="noopener noreferrer">{copy.projects.visit}<span aria-hidden="true">↗</span></a>
        </div>
      </article>)}
    </div>

    <p class="subsection-label">{copy.projects.otherLabel}</p>
    <div class="secondary-projects">
      {secondaryProjects.map((project) => <article class="secondary-project">
        <img src={project.image} alt={project.imageAlt} loading="lazy" decoding="async" />
        <div>
          <p class="project-kind">{project.kind}</p>
          <h3>{project.name}</h3>
          <p>{project.description}</p>
          {project.metric && <p class="metric">{project.metric}</p>}
          <a class="text-link" href={project.href} target="_blank" rel="noopener noreferrer">{copy.projects.visit}<span aria-hidden="true">↗</span></a>
        </div>
      </article>)}
    </div>
  </section>

  <section id="experience" class="section section-dark" aria-labelledby="experience-title">
    <div class="container">
      <div class="section-heading light">
        <h2 id="experience-title">{copy.experiences.title}</h2>
        <p>{copy.experiences.intro}</p>
      </div>
      <ol class="timeline">
        {copy.experiencesList.map((experience) => <li>
          <div class="timeline-meta"><p>{experience.period}</p><p>{experience.location}</p></div>
          <div class="timeline-copy"><h3>{experience.company}</h3><p class="role">{experience.role}</p><p>{experience.description}</p></div>
        </li>)}
      </ol>
    </div>
  </section>

  <section id="expertise" class="section container" aria-labelledby="expertise-title">
    <div class="section-heading">
      <h2 id="expertise-title">{copy.expertise.title}</h2>
    </div>
    <div class="expertise-grid">
      {copy.expertise.groups.map((group) => <article class="expertise-group"><h3>{group.label}</h3><ul>{group.items.map((item) => <li>{item}</li>)}</ul></article>)}
    </div>
  </section>

  <section id="contact" class="contact-section" aria-labelledby="contact-title">
    <div class="container contact-inner">
      <div><h2 id="contact-title">{copy.contact.title}</h2><p>{copy.contact.intro}</p></div>
      <div class="contact-links">
        <a href={socials.email}>{copy.contact.email}<span>contactfrytinhas1910@gmail.com</span></a>
        <a href={socials.linkedin} target="_blank" rel="noopener noreferrer">{copy.contact.linkedin}<span>/in/jg-nunes</span></a>
        <a href={socials.github} target="_blank" rel="noopener noreferrer">{copy.contact.github}<span>/frytinhas</span></a>
      </div>
    </div>
  </section>
</main>

<footer class="site-footer container"><span>{copy.footer}</span><a href="#about">↑</a></footer>
