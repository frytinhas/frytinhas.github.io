---
import '../styles/global.css';
import type { Locale } from '../data/portfolio';

interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
const canonicalPath = locale === 'pt' ? '/pt/' : '/';
const canonicalUrl = new URL(canonicalPath, Astro.site).href;
const personId = new URL('/#person', Astro.site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${canonicalUrl}#profile`,
  url: canonicalUrl,
  name: title,
  description,
  inLanguage: locale === 'pt' ? 'pt-BR' : 'en',
  mainEntity: {
    '@type': 'Person',
    '@id': personId,
    name: 'José Gabriel Jesuino Nunes',
    alternateName: ['José Nunes', 'Jose Nunes', 'Jose Gabriel Jesuino Nunes', 'frytinhas'],
    url: new URL('/', Astro.site).href,
    jobTitle: 'Gameplay Engineer',
    sameAs: ['https://github.com/frytinhas', 'https://www.linkedin.com/in/jg-nunes'],
  },
};
---

<!doctype html>
<html lang={locale === 'pt' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#081d42" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="iFyQ6aaCsIXj-QI6NJnuDjNDuVJiVKDUHZ4FQyEoOgM" />
    <link rel="icon" type="image/svg+xml" href="/jn-favicon.svg" />
    <link rel="icon" type="image/png" href="/jn-favicon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={new URL('/', Astro.site)} />
    <link rel="alternate" hreflang="pt-BR" href={new URL('/pt/', Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
  </head>
  <body data-locale={locale}>
    <a class="skip-link" href="#content">{locale === 'pt' ? 'Pular para o conteúdo' : 'Skip to content'}</a>
    <slot />
    <script is:inline>
      const preferenceKey = 'jose-nunes-locale';
      document.querySelectorAll('[data-language-switch]').forEach((link) => {
        link.addEventListener('click', () => localStorage.setItem(preferenceKey, link.dataset.languageSwitch));
      });

      if (document.body.dataset.locale === 'en' && window.location.pathname === '/') {
        const savedLocale = localStorage.getItem(preferenceKey);
        const browserLanguages = navigator.languages || [navigator.language];
        const wantsPortuguese = browserLanguages.some((language) => language?.toLowerCase().startsWith('pt'));
        if (savedLocale === 'pt' || (!savedLocale && wantsPortuguese)) window.location.replace('/pt/');
      }
    </script>
  </body>
</html>
